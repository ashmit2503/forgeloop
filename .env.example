# Local services
AUTOCODER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this to an installed model from `ollama list`.
AUTOCODER_DEFAULT_OLLAMA_MODEL=qwen2.5-coder:7b
AUTOCODER_PYTHON_IMAGE=autocoder-python:3.12

# History and generated workspaces. Existing installations retain this location.
AUTOCODER_DATA_DIR=.autocoder-data
# Optional: defaults to autocoder.db inside AUTOCODER_DATA_DIR.
# AUTOCODER_DATABASE_URL=sqlite:///./.autocoder-data/autocoder.db

# Hard limits for stored source and the coding loop
AUTOCODER_MAX_FILES=100
AUTOCODER_MAX_FILE_BYTES=524288
AUTOCODER_MAX_WORKSPACE_BYTES=5242880
AUTOCODER_AGENT_LOOP_TIMEOUT_SECONDS=1800
